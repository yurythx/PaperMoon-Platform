# Copiado/gerado pelo Ansible (role docker_app) a partir de
# ansible/playbooks/host_vars/test-stack.yml — NÃO editar o .env real à mão
# no host; editar o host_vars (vault-criptografado) e rodar o playbook de novo.
#
# Este .env.example serve só de referência do que a stack espera.

# Keycloak alvo do teste de carga — ver aviso de segurança no topo do
# locustfile.py antes de apontar isto pra um servidor real.
KEYCLOAK_URL=https://sso.rondonopolis.mt.gov.br
REALM_NAME=CHANGE_ME_REALM
CLIENT_ID=CHANGE_ME_CLIENT_ID
CLIENT_SECRET=CHANGE_ME_CLIENT_SECRET_OU_VAZIO_SE_CLIENT_PUBLICO

# Credenciais de um USUÁRIO DE TESTE dedicado — nunca uma conta real de
# funcionário (risco de lockout por política do AD).
LOCUST_TEST_USERNAME=CHANGE_ME_USUARIO_DE_TESTE
LOCUST_TEST_PASSWORD=CHANGE_ME_SENHA_DE_TESTE

# Alvos internos (LAN) da stack PaperMoon — não o domínio público.
DJANGO_API_URL=http://192.168.1.102:8000
NEXTJS_URL=http://192.168.1.102:3000
