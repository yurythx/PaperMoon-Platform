{# Gerado pelo Ansible — não editar manualmente no host. Baseado no config
   default que o install.sh do crowdsec-firewall-bouncer gera, só com
   api_url/api_key apontando pro LAPI central (CT 132) em vez de localhost. #}
mode: iptables
pid_dir: /var/run/
update_frequency: 10s
daemonize: true
log_mode: file
log_dir: /var/log/
log_level: info
log_compression: true
log_max_size: 100
log_max_backups: 3
log_max_age: 30
api_url: {{ crowdsec_lapi_url }}/
api_key: {{ crowdsec_bouncer_api_key }}
disable_ipv6: false
deny_action: DROP
deny_log: false
supported_decisions_types:
  - ban
iptables_chains:
  - INPUT
  # Sem isso, um IP banido continua alcançando as portas publicadas pelo
  # Docker (ex: 9090 do Prometheus) — o Docker insere suas próprias regras
  # que podem furar a chain INPUT padrão pra tráfego de containers. Achado
  # no primeiro deploy real (log do bouncer avisou: "The DOCKER-USER chain
  # exists, but is not configured for use by the bouncer").
  - DOCKER-USER
